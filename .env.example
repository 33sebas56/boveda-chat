# Opcional para desarrollo. Spring carga .env automaticamente.
# El modo local funciona sin Supabase, Docker ni PostgreSQL instalado.
SPRING_PROFILES_ACTIVE=local

# Administrador inicial opcional. Define ambos antes del primer arranque.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# En Render usar SPRING_PROFILES_ACTIVE=prod y configurar en Environment:
# DB_URL=jdbc:postgresql://HOST-DEL-SESSION-POOLER:5432/postgres?sslmode=verify-full&sslrootcert=/etc/secrets/supabase-ca.crt
# DB_USERNAME=USUARIO-EXACTO-DEL-SESSION-POOLER
# DB_PASSWORD=CONTRASENA-DE-POSTGRESQL
# BOVEDA_KEY=CLAVE-BASE64-DE-32-BYTES
# SUPABASE_URL=https://TU-PROYECTO.supabase.co
# SUPABASE_SECRET_KEY=CLAVE-SECRETA-DE-SERVIDOR
SUPABASE_BUCKET=boveda-chat

# Opcional. SMS reales necesitan cuenta y credenciales del proveedor.
SMS_ENABLED=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
SMS_DAILY_BUDGET=20
